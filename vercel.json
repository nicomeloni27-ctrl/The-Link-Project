{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth-resource"
    },
    {
      "source": "/oauth/consent",
      "destination": "/oauth/consent.html"
    }
  ]
}